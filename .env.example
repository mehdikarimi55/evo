# Choose one provider. Keep real keys only in .env.local.
EVO_PROVIDER=nvidia

# Groq
GROQ_API_KEY=your-new-groq-key
EVO_GROQ_MODEL=openai/gpt-oss-20b
EVO_GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA NIM (default provider)
NVIDIA_API_KEY=your-new-nvidia-key
EVO_NVIDIA_MODEL=meta/llama-3.1-70b-instruct
EVO_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Generation profile: precise | balanced | exploratory
EVO_NVIDIA_GENERATION_PROFILE=balanced
# Optional overrides:
# EVO_NVIDIA_TEMPERATURE=0.7
# EVO_NVIDIA_TOP_P=0.95
# EVO_NVIDIA_JSON_MODE=extract
# EVO_NVIDIA_REASONING_EFFORT=medium

EVO_MAX_INPUT_TOKENS=6000
EVO_MAX_OUTPUT_TOKENS=4096
EVO_MAX_CALLS_PER_RUN=4
EVO_REQUEST_TIMEOUT_SECONDS=90

# Optional v0.6 candidate lifecycle. Engine must run rootless.
EVO_SANDBOX_IMAGE=
EVO_SANDBOX_ENGINE=podman
EVO_EVALUATION_COMMAND=python -m unittest discover -s tests
EVO_SANDBOX_TIMEOUT_SECONDS=60
